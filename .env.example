NEXT_PUBLIC_API_HOST=http://localhost:4000
# Secreto privado: debe coincidir con JWT_SECRET del backend para verificar cookies en proxy.ts.
# Nunca usar NEXT_PUBLIC_ para este secreto. Generar un valor aleatorio de al menos 32 caracteres.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
